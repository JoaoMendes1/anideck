# Porta em que o servidor vai rodar localmente
PORT=8080

# Credenciais do Supabase (obtenha no dashboard do Supabase > Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLIC_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui
ADMIN_USER_ID=cole-seu-uuid-do-supabase-aqui

